        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "venue_id": {
              "type": "string",
              "format": "uuid",
              "description": "The venue's UUID."
